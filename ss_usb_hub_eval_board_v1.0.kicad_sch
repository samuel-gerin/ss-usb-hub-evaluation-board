	)
	(text "DESIGN NOTE:\nThe VDD33 supply must be very clean. Noise on VDD33\nmust be filtered out before it is received by the hub device. \nSome systems require < 5 mV of ripple on VDD33 at the hub\ndevice pins to pass SSC certification of the USB 3.1 Gen 1 \ntest suite. Switching regulators are a common source for\nVDD33 noise. That is why an LDO is used here. p2"
		(exclude_from_sim no)
		(at 144.78 259.08 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "10d669ff-cc9b-41e0-83b6-0e86593daca9")
	)
