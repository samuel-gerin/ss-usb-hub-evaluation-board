			)
			(justify left)
		)
		(uuid "dc91e4a2-7eba-446a-86a3-d17be4403058")
	)
	(text "DESIGN NOTE:\nDisable SPI by setting the SPI_DIS-ABLE \nbit in the UTIL_CONFIG1 reg.\nIf disabled the pins may not be floating\nand must be handled per their respective\natlernative pin functions descriptions\n(CFG_BC_EN and CFG_NON_REM), p. 14"
		(exclude_from_sim no)
		(at 205.74 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
