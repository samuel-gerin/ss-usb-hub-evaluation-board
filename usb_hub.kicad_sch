	(text "DESIGN NOTE:\nMicrochip provides a comprehensive software \nprogramming tool, Pro-Touch2, for configuring \nthe USB5906C functions,registers and OTP memory. \nAll configuration is to be performed via the\nPro-Touch2 programming tool."
		(exclude_from_sim no)
		(at 97.79 191.77 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "70736451-8988-4be6-9c2b-6cf811644a82")
	)
	(text "LAYOUT NOTE:\nPlace the resistor as close to the \ndevice as possible with a dedicated, \nlow impedance connection to the GND\nplane.\nThe return path must not be shared \nwith any other components."
		(exclude_from_sim no)
		(at 171.45 32.766 0)
		(effects
