	)
	(text "DESIGN NOTE:\nWhen the downstream port is enabled, this pin is set as\nan input with an internal pull-up resistor applied. The\ninternal pull-up enables power to the downstream port\nwhile the pin monitors for an active low overcurrent signal\nassertion from an external current monitor on USB port 1.\nThis pin will change to an output and be driven low when\nthe port is disabled by configuration or by the host control.\np13 PRT_CTLx"
		(exclude_from_sim no)
		(at 274.32 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "ccd95810-082c-418b-857f-2a980c00deca")
	)
	(text "DESIGN NOTE:\nEnable USB 3.2 PHYs at all time\npull-up, p. 14"
		(exclude_from_sim no)
