	(text "LAYOUT NOTE:\nThe connection of bypass capacitors to their pins, \nand to power and ground, must be low inductance\n(short and very wide traces). \np. 4 AN 26.21, 2.1.D\nRefer to the Microchip AN 26.2 application note for \nadditional details."
		(exclude_from_sim no)
		(at 191.77 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1d66b416-c56c-4bf9-bd69-6e3cc44a0abc")
	)
	(text "DESIGN NOTE:\nBoth PRT_DIS_Px and PRT_DIS_Mx\npulled high to disable\nthe associated downstream port. \nDisabling the USB 2.0 port \nwill also disable the corresponding \nUSB 3.2 Gen 1 port. p. 21"
		(exclude_from_sim no)
		(at 326.39 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "2022b4e2-a6fd-45e4-859e-797b0b14fbcd")
	)
	(text "DESIGN NOTE:\nFor stand-alone applications, RESETn should be connected \nto a supervisory circuit that monitors VDD12 and VDD33. \nRESETn should be asserted when either voltage is below its \nthreshold. RESETn could also be asserted under manual\nor host control. A simple RC circuit may be used for \nstand-alone applications, but this only follows one voltage\nrail andmay not work well when power is quickly removed \nthen reapplied to the system, and is therefore not recommended.\np.3 AN 26.2 2.4"
		(exclude_from_sim no)
		(at 22.86 80.772 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "22088307-54da-44ad-b4a9-f81a10698280")
	)
	(text "USB Hub"
		(exclude_from_sim no)
		(at 239.776 21.844 0)
		(effects
			(font
				(size 3.175 3.175)
				(thickness 0.508)
				(bold yes)
				(color 72 0 0 1)
			)
		)
		(uuid "23b3eb50-4ad4-4ab1-b472-bf8a63a7433a")
	)
	(text "DESIGN NOTE:\nHOST_TYPEO : \ndriven low 	-> USB 3 speed upstream\ndriven high	-> USB 2 speed upstream\nfloating 	-> no upstream"
		(exclude_from_sim no)
		(at 35.56 269.24 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "301a3b0d-52dc-4309-94f1-522c0cc20534")
	)
	(text "DESIGN NOTE:\n200k pull down,\nAll ports removable, \np.22"
		(exclude_from_sim no)
		(at 335.28 127 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "33c3d323-13c4-403c-b076-89f4e17fbe81")
	)
	(text "LAYOUT NOTE:\nRoute crystal traces at least 5 times the minimum \ntrace spacing away from other traces. Refer to the\np. 6 AN 26.21, 2.1.K\nMicrochip AN 26.2 application note for additional \ndetails."
		(exclude_from_sim no)
		(at 31.75 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3f42ccbb-8b37-4184-ab52-26d18970af56")
	)
